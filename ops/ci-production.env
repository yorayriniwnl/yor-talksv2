# Structural-only fixture for CI Compose validation. These values are not
# credentials and must never be used for a deployment.
NODE_ENV=production
POSTGRES_DB=yor_talks
POSTGRES_USER=yor_talks
POSTGRES_PASSWORD=ci-only-postgres-password-0123456789
DATABASE_URL=postgresql://yor_talks:ci-only-postgres-password-0123456789@postgres:5432/yor_talks
REDIS_PASSWORD=ci-only-redis-password-0123456789

JWT_SECRET=ci-only-jwt-access-secret-0123456789
JWT_REFRESH_SECRET=ci-only-jwt-refresh-secret-0123456789
CONTACT_SHIELD_SECRET=ci-only-contact-shield-secret-0123456789
TOTP_ENCRYPTION_KEY=ci-only-totp-encryption-key-0123456789

PUBLIC_BETA=true
TERMS_VERSION=ci-public-beta-1
MINIMUM_AGE=18
CLIENT_ORIGIN=https://ci.example
CORS_ORIGINS=https://ci.example
AUTH_COOKIE_SAME_SITE=lax
GOOGLE_CLIENT_ID=1234567890-ci.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=1234567890-ci.apps.googleusercontent.com

LEGAL_OPERATOR_NAME=CI Test Operator
LEGAL_OPERATOR_ADDRESS=1 Test Way, India
LEGAL_EFFECTIVE_DATE=2026-08-30
LEGAL_GOVERNING_LAW=India
PRIVACY_CONTACT_EMAIL=privacy@ci.example
SUPPORT_EMAIL=support@ci.example
GRIEVANCE_OFFICER_NAME=CI Test Officer
GRIEVANCE_CONTACT_EMAIL=grievance@ci.example

CLOUDINARY_CLOUD_NAME=ci-test-cloud
CLOUDINARY_API_KEY=ci-test-key
CLOUDINARY_API_SECRET=ci-test-secret
RESEND_API_KEY=ci-test-resend-key
EMAIL_FROM=ci@example.com
OPENAI_API_KEY=ci-test-openai-key

VITE_API_BASE_URL=/api
VITE_REALTIME_ENABLED=false
PAYMENTS_ENABLED=false
LIVE_ROOMS_ENABLED=false
WEB_PUSH_ENABLED=false
RTC_CALLS_ENABLED=false
