[Unit]
Description=Yor Talks encrypted off-host PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=yor-talks
Group=docker
WorkingDirectory=/opt/yor-talks
TimeoutStartSec=45min
ExecStart=/usr/bin/docker compose --env-file /etc/yor-talks/.env.production -f /opt/yor-talks/docker-compose.production.yml run --rm --no-deps backup backup