# Copy to .env.production and replace every value marked CHANGE_ME.
# Use URL-safe hex values for passwords that appear inside DATABASE_URL/REDIS_URL.
NODE_ENV=production
POSTGRES_DB=yor_talks
POSTGRES_USER=yor_talks
POSTGRES_PASSWORD=CHANGE_ME_64_HEX
DATABASE_URL=postgresql://yor_talks:CHANGE_ME_64_HEX@postgres:5432/yor_talks
REDIS_PASSWORD=CHANGE_ME_64_HEX

JWT_SECRET=CHANGE_ME_UNIQUE_64_HEX
JWT_REFRESH_SECRET=CHANGE_ME_UNIQUE_64_HEX
CONTACT_SHIELD_SECRET=CHANGE_ME_UNIQUE_64_HEX
# The included PostgreSQL container is not TLS-enabled. Set DB_SSL=true only
# when DATABASE_URL points to a database with TLS configured.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

CLIENT_ORIGIN=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
ALLOWED_EMAIL_DOMAINS=
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_WEB_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_WEB_CLIENT_ID
# Use the public HTTPS API origin when the frontend is deployed separately.
VITE_API_BASE_URL=https://api.your-domain.example/api
# Use the public long-lived Socket.IO origin; do not point this at a Vercel
# serverless function because WebSocket upgrades are not a durable process.
VITE_REALTIME_URL=https://api.your-domain.example
VITE_REALTIME_ENABLED=true
VITE_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
WEB_PORT=8080

CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=Yor Talks <no-reply@your-domain.example>

# Generate with `pnpm --filter @workspace/api-server exec web-push generate-vapid-keys`.
WEB_PUSH_VAPID_PUBLIC_KEY=CHANGE_ME
WEB_PUSH_VAPID_PRIVATE_KEY=CHANGE_ME
WEB_PUSH_VAPID_SUBJECT=mailto:security@your-domain.example

LIVEKIT_URL=wss://your-livekit.example
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
# Set at least one moderation provider key.
OPENAI_API_KEY=
GEMINI_API_KEY=
LOG_LEVEL=info
