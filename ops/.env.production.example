# Copy to .env.production and replace every value marked CHANGE_ME.
# Use URL-safe hex values for passwords that appear inside DATABASE_URL/REDIS_URL.
NODE_ENV=production
POSTGRES_DB=yor_talks
POSTGRES_USER=yor_talks
POSTGRES_PASSWORD=CHANGE_ME_64_HEX
DATABASE_URL=postgresql://yor_talks:CHANGE_ME_64_HEX@postgres:5432/yor_talks
REDIS_PASSWORD=CHANGE_ME_64_HEX

JWT_SECRET=CHANGE_ME_UNIQUE_64_HEX
JWT_REFRESH_SECRET=CHANGE_ME_UNIQUE_64_HEX
CONTACT_SHIELD_SECRET=CHANGE_ME_UNIQUE_64_HEX
TOTP_ENCRYPTION_KEY=CHANGE_ME_UNIQUE_64_HEX
PUBLIC_BETA=true
TERMS_VERSION=2026-08-public-beta-1
MINIMUM_AGE=18
# The included PostgreSQL container is not TLS-enabled. Set DB_SSL=true only
# when DATABASE_URL points to a database with TLS configured.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

CLIENT_ORIGIN=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
# Set only after inspecting actual peer addresses and selecting the ingress.
# TRUSTED_PROXY_CIDRS identifies API's approved final proxy peers; the optional
# TRUSTED_EDGE_CIDRS identifies Caddy peers as seen by Nginx. Comma-separated
# literal IPs/CIDRs only; leave empty to ignore all incoming forwarded headers.
# Do not trust a whole shared/private network or a fixed number of hops.
TRUSTED_PROXY_CIDRS=
TRUSTED_EDGE_CIDRS=
# Keep Lax when the web and API share a registrable domain. Use none only for
# a truly cross-site frontend; trusted-origin enforcement remains mandatory.
AUTH_COOKIE_SAME_SITE=lax
ALLOWED_EMAIL_DOMAINS=
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_WEB_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_WEB_CLIENT_ID
LEGAL_OPERATOR_NAME=CHANGE_ME
LEGAL_OPERATOR_ADDRESS=CHANGE_ME
LEGAL_EFFECTIVE_DATE=2026-08-30
LEGAL_GOVERNING_LAW=CHANGE_ME
PRIVACY_CONTACT_EMAIL=privacy@your-domain.example
SUPPORT_EMAIL=support@your-domain.example
GRIEVANCE_OFFICER_NAME=CHANGE_ME
GRIEVANCE_CONTACT_EMAIL=grievance@your-domain.example
# Use the public HTTPS API origin when the frontend is deployed separately.
VITE_API_BASE_URL=https://api.your-domain.example/api
# Use the public long-lived Socket.IO origin; do not point this at a Vercel
# serverless function because WebSocket upgrades are not a durable process.
VITE_REALTIME_URL=https://api.your-domain.example
VITE_REALTIME_ENABLED=true
VITE_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
VITE_PUBLIC_BETA=true
VITE_TERMS_VERSION=2026-08-public-beta-1
VITE_MINIMUM_AGE=18
VITE_LEGAL_OPERATOR_NAME=CHANGE_ME
VITE_LEGAL_OPERATOR_ADDRESS=CHANGE_ME
VITE_LEGAL_EFFECTIVE_DATE=2026-08-30
VITE_LEGAL_GOVERNING_LAW=CHANGE_ME
VITE_PRIVACY_CONTACT_EMAIL=privacy@your-domain.example
VITE_SUPPORT_EMAIL=support@your-domain.example
VITE_GRIEVANCE_OFFICER_NAME=CHANGE_ME
VITE_GRIEVANCE_CONTACT_EMAIL=grievance@your-domain.example
VITE_PAYMENTS_ENABLED=false
VITE_LIVE_ROOMS_ENABLED=false
VITE_WEB_PUSH_ENABLED=false
VITE_RTC_CALLS_ENABLED=false
WEB_PORT=8080
API_HOST_PORT=4000

CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
# Signed presets are inspected with the Cloudinary Admin API. No unsigned preset
# or incoming/eager transformation is accepted. Gemini media moderation and the
# container's actual ffprobe/ffmpeg decoder are required for media approval.
CLOUDINARY_MEDIA_IMAGE_PRESET=
CLOUDINARY_MEDIA_VIDEO_PRESET=
CLOUDINARY_MEDIA_AUDIO_PRESET=
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_DECODE_TIMEOUT_MS=30000
MEDIA_DECODE_CONCURRENCY=2
MEDIA_PROVIDER_TIMEOUT_MS=15000
MEDIA_MODERATION_TIMEOUT_MS=30000
MEDIA_SIGNED_URL_TTL_SECONDS=300
# HTTPS API origin; leave blank only when CLIENT_ORIGIN serves /api.
MEDIA_DELIVERY_ORIGIN=
MEDIA_GEMINI_MODEL=gemini-2.5-flash
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=Yor Talks <no-reply@your-domain.example>

# Generate with `pnpm --filter @workspace/api-server exec web-push generate-vapid-keys`.
WEB_PUSH_VAPID_PUBLIC_KEY=CHANGE_ME
WEB_PUSH_VAPID_PRIVATE_KEY=CHANGE_ME
WEB_PUSH_VAPID_SUBJECT=mailto:security@your-domain.example

LIVEKIT_URL=wss://your-livekit.example
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVE_ROOMS_ENABLED=false
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_ID=
# Generate a separate 32+ character secret; retain it to decrypt accepted events.
PAYMENT_EVENT_ENCRYPTION_KEY=
YOR_PREMIUM_ENABLED=false
YOR_PREMIUM_PRICE_MINOR=0
YOR_PREMIUM_DURATION_DAYS=30
YOR_PREMIUM_TERMS_VERSION=
YOR_PREMIUM_REFUND_POLICY=
YOR_ADVANCED_DEFAULT_ENABLED=true
RAZORPAY_WEBHOOK_SECRET=
WEB_PUSH_ENABLED=false
RTC_CALLS_ENABLED=false
# Set at least one moderation provider key.
OPENAI_API_KEY=
GEMINI_API_KEY=
LOG_LEVEL=info

# Internal monitoring/backup jobs. Generate a separate random metrics token,
# keep both files readable only by the deployment operator, and configure the
# rclone remote's server-side lifecycle retention (the application never deletes remote objects).
METRICS_BEARER_TOKEN_FILE=/etc/yor-talks/metrics.token
ALERTMANAGER_WEBHOOK_URL=https://CHANGE_ME-alert-receiver.example/webhook
ALERTMANAGER_WEBHOOK_USER=yor-talks-alerts
ALERTMANAGER_WEBHOOK_PASSWORD_FILE=/etc/yor-talks/alertmanager-webhook-password
RCLONE_CONFIG_FILE=/etc/yor-talks/rclone.conf
BACKUP_AGE_RECIPIENT=CHANGE_ME_AGE_RECIPIENT
BACKUP_REMOTE=CHANGE_ME_REMOTE:yor-talks
BACKUP_LOCAL_RETENTION_DAYS=14
