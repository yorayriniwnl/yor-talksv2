# ==============================================================================
# Yor Talks Staging Environment Template
# Copy to .env.staging and replace every value marked CHANGE_ME_STAGING.
# Keep outside Git with mode 0640, owned by root:docker.
# Staging must NEVER reuse production database, cache, or credentials.
# ==============================================================================

NODE_ENV=production
POSTGRES_DB=yor_talks_staging
POSTGRES_USER=yor_talks_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_64_HEX
DATABASE_URL=postgresql://yor_talks_staging:CHANGE_ME_STAGING_64_HEX@postgres:5432/yor_talks_staging
REDIS_PASSWORD=CHANGE_ME_STAGING_64_HEX

# Generate independent 64-character hex secrets (e.g. openssl rand -hex 32)
# NEVER reuse production JWT, contact-shield, or TOTP secrets in staging
JWT_SECRET=CHANGE_ME_STAGING_UNIQUE_JWT_SECRET_HEX_64_CHARS_0123456789012345678
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_UNIQUE_JWT_REFRESH_SECRET_HEX_64_CHARS_012345
CONTACT_SHIELD_SECRET=CHANGE_ME_STAGING_UNIQUE_CONTACT_SHIELD_SECRET_HEX_64_CHARS_
TOTP_ENCRYPTION_KEY=CHANGE_ME_STAGING_UNIQUE_TOTP_ENCRYPTION_KEY_HEX_64_CHARS_012

PUBLIC_BETA=false
TERMS_VERSION=2026-08-staging-1
MINIMUM_AGE=18
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Staging URLs and Origins
CLIENT_ORIGIN=https://staging.your-domain.example
CORS_ORIGINS=https://staging.your-domain.example
AUTH_COOKIE_SAME_SITE=lax
TRUSTED_PROXY_CIDRS=

# Closed beta test audience: comma-separated list of allowed tester email domains
ALLOWED_EMAIL_DOMAINS=your-org.example,staging-testers.example

# Google OAuth Web Client ID for staging origin
GOOGLE_CLIENT_ID=CHANGE_ME_STAGING_GOOGLE_WEB_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=CHANGE_ME_STAGING_GOOGLE_WEB_CLIENT_ID

LEGAL_OPERATOR_NAME=Yor Talks Staging Test Operator
LEGAL_OPERATOR_ADDRESS=Staging Test Lab
LEGAL_EFFECTIVE_DATE=2026-08-30
LEGAL_GOVERNING_LAW=Test Jurisdiction
PRIVACY_CONTACT_EMAIL=staging-privacy@your-domain.example
SUPPORT_EMAIL=staging-support@your-domain.example
GRIEVANCE_OFFICER_NAME=Staging Test Officer
GRIEVANCE_CONTACT_EMAIL=staging-grievance@your-domain.example

# Frontend build wiring
VITE_API_BASE_URL=https://staging-api.your-domain.example/api
VITE_REALTIME_URL=https://staging-api.your-domain.example
VITE_REALTIME_ENABLED=true
VITE_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
VITE_PUBLIC_BETA=false
VITE_TERMS_VERSION=2026-08-staging-1
VITE_MINIMUM_AGE=18
VITE_LEGAL_OPERATOR_NAME=Yor Talks Staging Test Operator
VITE_LEGAL_OPERATOR_ADDRESS=Staging Test Lab
VITE_LEGAL_EFFECTIVE_DATE=2026-08-30
VITE_LEGAL_GOVERNING_LAW=Test Jurisdiction
VITE_PRIVACY_CONTACT_EMAIL=staging-privacy@your-domain.example
VITE_SUPPORT_EMAIL=staging-support@your-domain.example
VITE_GRIEVANCE_OFFICER_NAME=Staging Test Officer
VITE_GRIEVANCE_CONTACT_EMAIL=staging-grievance@your-domain.example
VITE_PAYMENTS_ENABLED=false
VITE_LIVE_ROOMS_ENABLED=false
VITE_WEB_PUSH_ENABLED=false
VITE_RTC_CALLS_ENABLED=false

# Staging host ports (offset from production 8080/4000 to prevent port collisions if co-located)
WEB_PORT=8081
API_HOST_PORT=4001
TRUSTED_EDGE_CIDRS=

# Media Storage (use separate staging Cloudinary sub-account or dedicated staging presets)
CLOUDINARY_CLOUD_NAME=CHANGE_ME_STAGING
CLOUDINARY_API_KEY=CHANGE_ME_STAGING
CLOUDINARY_API_SECRET=CHANGE_ME_STAGING
CLOUDINARY_MEDIA_IMAGE_PRESET=staging_image_preset
CLOUDINARY_MEDIA_VIDEO_PRESET=staging_video_preset
CLOUDINARY_MEDIA_AUDIO_PRESET=staging_audio_preset
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_DECODE_TIMEOUT_MS=30000
MEDIA_DECODE_CONCURRENCY=2
MEDIA_PROVIDER_TIMEOUT_MS=15000
MEDIA_MODERATION_TIMEOUT_MS=30000
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_DELIVERY_ORIGIN=https://staging-api.your-domain.example
MEDIA_GEMINI_MODEL=gemini-2.5-flash

# Email Delivery (use Resend staging or test sender domain)
RESEND_API_KEY=CHANGE_ME_STAGING
EMAIL_FROM=Yor Talks Staging <staging@your-domain.example>

# Web Push (generate staging keys: `pnpm --filter @workspace/api-server exec web-push generate-vapid-keys`)
WEB_PUSH_VAPID_PUBLIC_KEY=CHANGE_ME_STAGING
WEB_PUSH_VAPID_PRIVATE_KEY=CHANGE_ME_STAGING
WEB_PUSH_VAPID_SUBJECT=mailto:staging-security@your-domain.example

# Realtime & Live (disabled by default in staging)
LIVEKIT_URL=wss://staging-livekit.your-domain.example
LIVEKIT_API_KEY=CHANGE_ME_STAGING
LIVEKIT_API_SECRET=CHANGE_ME_STAGING
LIVE_ROOMS_ENABLED=false
RTC_CALLS_ENABLED=false

# Payments (Razorpay test mode keys ONLY: rzp_test_*)
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_ID=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_EVENT_ENCRYPTION_KEY=
YOR_PREMIUM_ENABLED=false
YOR_PREMIUM_PRICE_MINOR=0
YOR_PREMIUM_DURATION_DAYS=30
YOR_PREMIUM_TERMS_VERSION=
YOR_PREMIUM_REFUND_POLICY=
YOR_ADVANCED_DEFAULT_ENABLED=true

# Feature flags & Commerce (disabled by default in staging)
WEB_PUSH_ENABLED=false
SELLER_ENABLED=false
MEMBERSHIPS_ENABLED=false
AI_COMPANION_ENABLED=false
ELIGIBILITY_ASSURANCE_ADAPTER=unavailable
ELIGIBILITY_POLICY_SOURCE=approved_registry

# Moderation API keys
OPENAI_API_KEY=
GEMINI_API_KEY=
LOG_LEVEL=debug

# Staging Monitoring and Backup Secret Paths
METRICS_BEARER_TOKEN_FILE=/etc/yor-talks/staging-metrics.token
ALERTMANAGER_WEBHOOK_URL=https://staging-alerts.your-domain.example/webhook
ALERTMANAGER_WEBHOOK_USER=yor-talks-staging-alerts
ALERTMANAGER_WEBHOOK_PASSWORD_FILE=/etc/yor-talks/staging-alertmanager-webhook-password
RCLONE_CONFIG_FILE=/etc/yor-talks/staging-rclone.conf
BACKUP_AGE_RECIPIENT=CHANGE_ME_STAGING_AGE_RECIPIENT
BACKUP_REMOTE=CHANGE_ME_STAGING_REMOTE:yor-talks-staging
BACKUP_LOCAL_RETENTION_DAYS=7
