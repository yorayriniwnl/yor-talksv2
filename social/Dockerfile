FROM node:24-alpine AS build

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY api-server/package.json api-server/package.json
COPY mockup-sandbox/package.json mockup-sandbox/package.json
COPY scripts/package.json scripts/package.json
COPY social/package.json social/package.json
COPY lib/api-client-react/package.json lib/api-client-react/package.json
COPY lib/api-spec/package.json lib/api-spec/package.json
COPY lib/api-zod/package.json lib/api-zod/package.json
COPY lib/db/package.json lib/db/package.json
COPY lib/shared/package.json lib/shared/package.json
RUN pnpm install --frozen-lockfile

COPY . .
ARG VITE_API_BASE_URL=/api
ARG VITE_REALTIME_URL=
ARG VITE_REALTIME_ENABLED=true
ARG VITE_GOOGLE_CLIENT_ID=
ARG VITE_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
ARG VITE_PUBLIC_BETA=false
ARG VITE_TERMS_VERSION=development
ARG VITE_MINIMUM_AGE=18
ARG VITE_LEGAL_OPERATOR_NAME=
ARG VITE_LEGAL_OPERATOR_ADDRESS=
ARG VITE_LEGAL_EFFECTIVE_DATE=
ARG VITE_LEGAL_GOVERNING_LAW=
ARG VITE_PRIVACY_CONTACT_EMAIL=
ARG VITE_SUPPORT_EMAIL=
ARG VITE_GRIEVANCE_OFFICER_NAME=
ARG VITE_GRIEVANCE_CONTACT_EMAIL=
ARG VITE_PAYMENTS_ENABLED=false
ARG VITE_LIVE_ROOMS_ENABLED=false
ARG VITE_WEB_PUSH_ENABLED=false
ARG VITE_RTC_CALLS_ENABLED=false
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_REALTIME_URL=$VITE_REALTIME_URL
ENV VITE_REALTIME_ENABLED=$VITE_REALTIME_ENABLED
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_RTC_ICE_SERVERS=$VITE_RTC_ICE_SERVERS
ENV VITE_PUBLIC_BETA=$VITE_PUBLIC_BETA
ENV VITE_TERMS_VERSION=$VITE_TERMS_VERSION
ENV VITE_MINIMUM_AGE=$VITE_MINIMUM_AGE
ENV VITE_LEGAL_OPERATOR_NAME=$VITE_LEGAL_OPERATOR_NAME
ENV VITE_LEGAL_OPERATOR_ADDRESS=$VITE_LEGAL_OPERATOR_ADDRESS
ENV VITE_LEGAL_EFFECTIVE_DATE=$VITE_LEGAL_EFFECTIVE_DATE
ENV VITE_LEGAL_GOVERNING_LAW=$VITE_LEGAL_GOVERNING_LAW
ENV VITE_PRIVACY_CONTACT_EMAIL=$VITE_PRIVACY_CONTACT_EMAIL
ENV VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL
ENV VITE_GRIEVANCE_OFFICER_NAME=$VITE_GRIEVANCE_OFFICER_NAME
ENV VITE_GRIEVANCE_CONTACT_EMAIL=$VITE_GRIEVANCE_CONTACT_EMAIL
ENV VITE_PAYMENTS_ENABLED=$VITE_PAYMENTS_ENABLED
ENV VITE_LIVE_ROOMS_ENABLED=$VITE_LIVE_ROOMS_ENABLED
ENV VITE_WEB_PUSH_ENABLED=$VITE_WEB_PUSH_ENABLED
ENV VITE_RTC_CALLS_ENABLED=$VITE_RTC_CALLS_ENABLED
RUN pnpm --filter @workspace/social build

FROM nginx:1.30-alpine

COPY --from=build /app/social/dist/public /usr/share/nginx/html
COPY social/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
