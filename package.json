{
	"private": true,
	"packageManager": "pnpm@9.15.4",
	"engines": {
		"node": ">=20.0.0"
	},
	"workspaces": [
		"api-server",
		"lib/*",
		"lib/integrations/*",
		"scripts",
		"social"
	],
	"dependencies": {
		"esbuild": "0.28.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@types/express": "^5.0.6",
		"@types/node": "^25.3.3",
		"express": "^5.2.1",
		"typescript": "5.6.3"
	},
	"optionalDependencies": {
		"@esbuild/linux-x64": "^0.27.3",
		"@esbuild/win32-x64": "^0.27.3",
		"@rollup/rollup-linux-x64-gnu": "^4.62.2",
		"@rollup/rollup-win32-x64-msvc": "^4.62.2",
		"lightningcss-linux-x64-gnu": "1.32.0",
		"lightningcss-win32-x64-msvc": "1.32.0"
	},
	"scripts": {
		"build": "node ./build.mjs",
		"build:pnpm": "pnpm --filter @workspace/db build && pnpm --filter @workspace/api-server build && pnpm --filter @workspace/social build",
		"contract:generate": "node ./scripts/generate-api-contract.mjs",
		"contract:check": "node ./scripts/generate-api-contract.mjs --check",
		"production-config:check": "node ./scripts/check-production-config.mjs",
		"test:e2e": "playwright test",
		"test:unit": "node --test tests/*.test.mjs",
		"smoke": "node ./ops/smoke-test.mjs",
		"dev": "node ./dev.mjs",
		"dev:api": "npm run --prefix api-server dev",
		"dev:web": "npm run --prefix social dev"
	}
}
