{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./account-erasure": {
      "types": "./runtime/account-erasure.d.mts",
      "default": "./runtime/account-erasure.mjs"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "migrate:beta": "node ./scripts/migrate-beta.mjs",
    "migrate:production": "node ./scripts/migrate-production.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/pg": "^8.20.3",
    "drizzle-kit": "^0.31.10"
  }
}
