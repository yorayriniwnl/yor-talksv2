# Copy this file to .env and fill in real values. Required to run the server
# or the test suite at all — config/env.ts throws on startup if any required
# value below is missing.

PORT=4000
NODE_ENV=development

# Postgres connection string. `docker-compose up` provides a matching local db,
# or point this at any Postgres 16 instance. Run `pnpm --filter @workspace/db
# exec drizzle-kit push` once to create the schema.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yor_talks

REDIS_URL=redis://127.0.0.1:6379

# Any long random string works for local dev. Use a real secret (32+ bytes,
# e.g. `openssl rand -hex 32`) in anything resembling production, and never
# reuse the same value for both.
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# HMAC key used to protect selected contact identifiers. Use a unique 32+ byte
# secret in beta/production and never reuse a JWT key.
CONTACT_SHIELD_SECRET=change-me-contact-shield

# Comma-separated list of browser origins allowed to call this API with
# credentials. The Vite dev server proxies /api itself (see social/vite.config.ts),
# so this default only matters if you call the API directly from the browser.
CORS_ORIGINS=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=
GOOGLE_CLIENT_ID=

# Optional in development (uploads use a local data URL fallback); required for
# real production media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend email delivery. EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM=

# Optional browser push delivery. Generate with `pnpm exec web-push generate-vapid-keys`.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:security@yortalks.com

# Razorpay order creation and server-side payment verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# LiveKit Cloud room token generation.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
