# Copy this file to .env and fill in real values. Required to run the server
# or the test suite at all — config/env.ts throws on startup if any required
# value below is missing.

PORT=4000
NODE_ENV=development

# Postgres connection string. `docker-compose up` provides a matching local db,
# or point this at any Postgres 16 instance. Run `pnpm --filter @workspace/db
# exec drizzle-kit push` once to create the schema.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yor_talks

REDIS_URL=redis://127.0.0.1:6379

# Any long random string works for local dev. Use a real secret (32+ bytes,
# e.g. `openssl rand -hex 32`) in anything resembling production, and never
# reuse the same value for both.
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# HMAC key used to protect selected contact identifiers. Use a unique 32+ byte
# secret in beta/production and never reuse a JWT key.
CONTACT_SHIELD_SECRET=change-me-contact-shield
TOTP_ENCRYPTION_KEY=change-me-totp-encryption-key
PUBLIC_BETA=false
TERMS_VERSION=development
MINIMUM_AGE=18

# Comma-separated list of browser origins allowed to call this API with
# credentials. The Vite dev server proxies /api itself (see social/vite.config.ts),
# so this default only matters if you call the API directly from the browser.
CORS_ORIGINS=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=
GOOGLE_CLIENT_ID=

# Media uploads require actual storage, decoder and Gemini moderation configuration.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Every new upload uses the server-owned lifecycle; there is no data-URL fallback.
# Configure signed presets: type=authenticated, overwrite=false, exact allowed formats.
CLOUDINARY_MEDIA_IMAGE_PRESET=
CLOUDINARY_MEDIA_VIDEO_PRESET=
CLOUDINARY_MEDIA_AUDIO_PRESET=
# Media moderation requires Gemini, independently of the text provider.
GEMINI_API_KEY=
MEDIA_GEMINI_MODEL=gemini-2.5-flash
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_DECODE_TIMEOUT_MS=30000
MEDIA_DECODE_CONCURRENCY=2
MEDIA_PROVIDER_TIMEOUT_MS=15000
MEDIA_MODERATION_TIMEOUT_MS=30000
MEDIA_SIGNED_URL_TTL_SECONDS=300
# HTTPS origin serving the API, when it differs from CLIENT_ORIGIN.
MEDIA_DELIVERY_ORIGIN=

# Resend email delivery. EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM=

# Optional browser push delivery. Generate with `pnpm exec web-push generate-vapid-keys`.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:security@yortalks.com

# Razorpay order creation and server-side payment verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
RAZORPAY_ACCOUNT_ID=
PAYMENT_EVENT_ENCRYPTION_KEY=
YOR_PREMIUM_ENABLED=false
YOR_PREMIUM_PRICE_MINOR=0
YOR_PREMIUM_DURATION_DAYS=30
YOR_PREMIUM_TERMS_VERSION=
YOR_PREMIUM_REFUND_POLICY=
# Operational availability only; paid access or a temporary override is still required.
YOR_ADVANCED_DEFAULT_ENABLED=true

# LiveKit Cloud room token generation.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVE_ROOMS_ENABLED=false
WEB_PUSH_ENABLED=false
RTC_CALLS_ENABLED=false

# Separate adult-only feature releases; eligibility/policy approval is also required.
SELLER_ENABLED=false
MEMBERSHIPS_ENABLED=false
AI_COMPANION_ENABLED=false
# No live assurance adapter or approved operator/territory is supplied yet.
# Test fixtures use explicit test setup and cannot be selected through these keys.
ELIGIBILITY_ASSURANCE_ADAPTER=unavailable
ELIGIBILITY_POLICY_SOURCE=approved_registry
# Optional analytics/profiling stay disabled in the server decision for every age.

# Required when PUBLIC_BETA=true; use the real appointed operator details.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_EFFECTIVE_DATE=
LEGAL_GOVERNING_LAW=
PRIVACY_CONTACT_EMAIL=
SUPPORT_EMAIL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_CONTACT_EMAIL=
