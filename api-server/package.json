{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --import tsx ./src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node --import tsx ./src/scripts/seed-database.ts",
    "seed-massive": "node --import tsx ./src/scripts/seed-massive.ts",
    "seed-ultra": "node --import tsx ./src/scripts/seed-ultra-massive.ts",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "file:../lib/api-zod",
    "@workspace/db": "file:../lib/db",
    "bcryptjs": "^2.4.0",
    "bullmq": "^5.8.2",
    "cloudinary": "^2.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "minimist": "^1.2.8",
    "multer": "^2.2.0",
    "otplib": "^12.0.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/compression": "^1.7.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/minimist": "^1.2.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.20.3",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.20.2",
    "typescript": "5.6.3"
  }
}
