# Root variables consumed by the development docker-compose.yml.
# For production, copy ops/.env.production.example to .env.production and use
# docker-compose.production.yml; it fails closed when secrets are missing.
# Replace the JWT values before any production-like deployment.
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CONTACT_SHIELD_SECRET=replace-with-a-third-random-secret-at-least-32-characters
TOTP_ENCRYPTION_KEY=replace-with-a-fourth-random-secret-at-least-32-characters
PUBLIC_BETA=false
TERMS_VERSION=development
MINIMUM_AGE=18
CORS_ORIGINS=http://localhost:8080
CLIENT_ORIGIN=http://localhost:8080
ALLOWED_EMAIL_DOMAINS=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Optional when the frontend and API are hosted separately. Leave blank when
# Vercel rewrites /api to the API or when both are served behind one origin.
VITE_API_BASE_URL=
# Long-lived Socket.IO endpoint. Vercel serverless functions cannot host this;
# point it at the long-lived API service for messages, notifications, and calls.
VITE_REALTIME_URL=
# Set true only when the deployment serves a long-lived Socket.IO process
# (the production Docker/Nginx stack does; Vercel serverless does not).
VITE_REALTIME_ENABLED=false
VITE_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Image/media storage. Production uploads are unavailable without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email delivery (Resend). EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM=

# Web Push (generate once with `pnpm --filter @workspace/api-server exec web-push generate-vapid-keys`).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:security@yortalks.com

# Payments (Razorpay test or live keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false

# Live video/audio (LiveKit Cloud project).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVE_ROOMS_ENABLED=false
WEB_PUSH_ENABLED=false
RTC_CALLS_ENABLED=false

# Required when PUBLIC_BETA=true. Never use placeholder identity data in a
# public build.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_EFFECTIVE_DATE=
LEGAL_GOVERNING_LAW=
PRIVACY_CONTACT_EMAIL=
SUPPORT_EMAIL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_CONTACT_EMAIL=
