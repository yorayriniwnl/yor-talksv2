# Root variables consumed by the development docker-compose.yml.
# For production, copy ops/.env.production.example to .env.production and use
# docker-compose.production.yml; it fails closed when secrets are missing.
# Replace the JWT values before any production-like deployment.
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CONTACT_SHIELD_SECRET=replace-with-a-third-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:8080
CLIENT_ORIGIN=http://localhost:8080
ALLOWED_EMAIL_DOMAINS=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Image/media storage. Production uploads are unavailable without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email delivery (Resend). EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM=

# Web Push (generate once with `pnpm --filter @workspace/api-server exec web-push generate-vapid-keys`).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:security@yortalks.com

# Payments (Razorpay test or live keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Live video/audio (LiveKit Cloud project).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
